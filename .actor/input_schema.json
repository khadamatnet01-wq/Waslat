{
    "title": "إعدادات سحب وصلت",
    "description": "ضبط معاملات البحث في موقع وصلت (Wasalt)",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "city": {
            "title": "المدينة",
            "type": "string",
            "description": "اسم المدينة التي تريد البحث فيها.",
            "default": "الرياض",
            "editor": "textfield"
        },
        "cityId": {
            "title": "معرّف المدينة",
            "type": "integer",
            "description": "معرّف المدينة في وصلت. الرياض = 273.",
            "default": 273,
            "minimum": 1,
            "editor": "number"
        },
        "listingType": {
            "title": "نوع العملية",
            "type": "string",
            "description": "نوع الإعلان: sale للبيع أو rent للإيجار.",
            "default": "sale",
            "enum": [
                "sale",
                "rent"
            ],
            "enumTitles": [
                "للبيع",
                "للإيجار"
            ],
            "editor": "select"
        },
        "propertyType": {
            "title": "نوع العقار",
            "type": "string",
            "description": "نوع العقار المطلوب البحث عنه.",
            "default": "residential",
            "enum": [
                "residential"
            ],
            "enumTitles": [
                "سكني"
            ],
            "editor": "select"
        },
        "maxResults": {
            "title": "أقصى عدد للنتائج",
            "type": "integer",
            "description": "عدد الإعلانات المطلوب استخراجها وحفظها.",
            "default": 20,
            "minimum": 1,
            "maximum": 500,
            "editor": "number"
        },
        "todayOnly": {
            "title": "إعلانات اليوم فقط",
            "type": "boolean",
            "description": "عند التفعيل، يتم حفظ الإعلانات التي تاريخ نشرها هو اليوم فقط حسب توقيت الرياض. يتم التحقق من تاريخ الإعلان من صفحة التفاصيل قبل حفظه.",
            "default": false,
            "editor": "checkbox"
        },
        "maxScrollRounds": {
            "title": "عمق البحث",
            "type": "integer",
            "description": "عدد جولات التمرير في نتائج وصلت لاكتشاف إعلانات إضافية. عند تفعيل إعلانات اليوم فقط، يُفضّل رفع الرقم لأن الإعلانات القديمة قد تظهر قبل إعلانات اليوم.",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "editor": "number"
        },
        "proxyConfiguration": {
            "title": "إعدادات البروكسي",
            "type": "object",
            "description": "استخدام Apify Residential Proxy لتقليل احتمالية الحجب.",
            "prefill": {
                "useApifyProxy": true,
                "groups": [
                    "RESIDENTIAL"
                ]
            },
            "editor": "proxy"
        },
        "webhookUrl": {
            "title": "رابط Webhook (اختياري)",
            "type": "string",
            "description": "رابط يُرسل إليه إشعار JSON عند اكتمال السحب.",
            "editor": "textfield"
        }
    }
}
